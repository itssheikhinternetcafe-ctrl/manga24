rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authority is issued only by the Firebase Admin SDK.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isCreator() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.get('role', '') == 'creator' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'creator'
      );
    }

    // Series collection: active stories are public; authors can save drafts privately in the UI.
    match /series/{seriesId} {
      allow read: if isAdmin() || resource.data.get('moderationStatus', 'active') == 'active';
      allow create: if isAdmin() || (
        isAuthenticated() &&
        isCreator() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.contentRating in ['safe', '16+', '18+'] &&
        request.resource.data.get('moderationStatus', 'active') == 'active' &&
        request.resource.data.get('flaggedForReview', false) == false &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) != true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('creatorStatus', 'active') == 'active' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('strikes', 0) < 3 &&
        request.resource.data.createdAt is string &&
        (!request.resource.data.keys().hasAny(['featured']) || request.resource.data.featured == false) &&
        (!request.resource.data.keys().hasAny(['isFeatured']) || request.resource.data.isFeatured == false) &&
        (!request.resource.data.keys().hasAny(['isTrending']) || request.resource.data.isTrending == false) &&
        (!request.resource.data.keys().hasAny(['isEditorPick']) || request.resource.data.isEditorPick == false) &&
        (!request.resource.data.keys().hasAny(['views']) || request.resource.data.views == 0) &&
        (!request.resource.data.keys().hasAny(['followersCount']) || request.resource.data.followersCount == 0) &&
        (!request.resource.data.keys().hasAny(['rating']) || request.resource.data.rating == 0) &&
        (!request.resource.data.keys().hasAny(['ratingCount']) || request.resource.data.ratingCount == 0)
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.authorId == request.auth.uid &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.contentRating in ['safe', '16+', '18+'] &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'featured', 'isFeatured', 'isTrending', 'isEditorPick',
          'views', 'followersCount', 'rating', 'ratingCount', 'createdAt', 'approvedAdultChapters', 'strikes', 'isBanned', 'role',
          'contentRating', 'moderationStatus', 'flaggedForReview', 'moderationUpdatedAt', 'moderationUpdatedBy', 'coverAssetId'
        ])
      ) || (
        resource.data.get('moderationStatus', 'active') == 'active' &&
        request.resource.data.get('moderationStatus', 'active') == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.get('views', 0) == resource.data.get('views', 0) + 1
      ) || (
        isAuthenticated() &&
        resource.data.get('moderationStatus', 'active') == 'active' &&
        request.resource.data.get('moderationStatus', 'active') == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']) &&
        (
          request.resource.data.get('followersCount', 0) == resource.data.get('followersCount', 0) + 1 ||
          request.resource.data.get('followersCount', 0) == resource.data.get('followersCount', 0) - 1
        )
      );
      allow delete: if isAdmin();
    }

    // Chapters are published directly by their authors.
    match /chapters/{chapterId} {
      allow read: if isAdmin() ||
        get(/databases/$(database)/documents/series/$(resource.data.seriesId)).data.get('moderationStatus', 'active') == 'active';
      allow create: if (
        isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('creatorStatus', 'active') == 'active'
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.authorId == request.auth.uid &&
        request.resource.data.authorId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['flagged'])
      );
      allow delete: if isAdmin();
    }

    // Users collection.
    // SECURITY: a normal user can NEVER change their own role / ban status.
    // Admin is set manually in Firebase Console (users/{uid}.role = "admin").
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('isBanned', false) == resource.data.get('isBanned', false) &&
        request.resource.data.get('strikes', 0) == resource.data.get('strikes', 0)
        && request.resource.data.get('approvedAdultChapters', 0) == resource.data.get('approvedAdultChapters', 0)
        && request.resource.data.get('creatorStatus', 'active') == resource.data.get('creatorStatus', 'active')
        && request.resource.data.get('emailNormalized', '') == resource.data.get('emailNormalized', '')
        && request.resource.data.get('moderationUpdatedAt', '') == resource.data.get('moderationUpdatedAt', '')
        && request.resource.data.get('moderationUpdatedBy', '') == resource.data.get('moderationUpdatedBy', '')
      );
      allow delete: if isAdmin();
    }

    // Follows collection
    match /follows/{followId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User Library & History
    match /library/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    match /readingHistory/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.createdAt is string &&
        request.resource.data.likes == 0 &&
        request.resource.data.dislikes == 0 &&
        request.resource.data.get('isDeleted', false) == false;
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Collections (user curated reading lists)
    match /collections/{collectionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // Community forum posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.createdAt is string &&
        request.resource.data.get('pinned', false) == false &&
        request.resource.data.get('likes', 0) == 0 &&
        request.resource.data.get('commentCount', 0) == 0;
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Reports may be submitted by guests, but only admins can review them.
    match /reports/{reportId} {
      allow create: if request.resource.data.keys().hasAll(['seriesId', 'reason', 'createdAt', 'status']) &&
        request.resource.data.keys().hasOnly(['id', 'reporterId', 'seriesId', 'chapterId', 'reason', 'message', 'createdAt', 'status']) &&
        request.resource.data.reason in ['Copyright/stolen', 'Minor/child content', 'Non-consensual/real person', 'Wrong content rating', 'Other'] &&
        request.resource.data.createdAt is string &&
        request.resource.data.status == 'open' &&
        request.resource.data.seriesId is string &&
        request.resource.data.message is string &&
        (!request.resource.data.keys().hasAny(['chapterId']) || request.resource.data.chapterId is string) &&
        (!request.resource.data.keys().hasAny(['reporterId']) ||
          (isAuthenticated() && request.resource.data.reporterId == request.auth.uid));
      allow read, update, delete: if isAdmin();
    }

    // Site Settings (admin only write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /bannedEmails/{email} {
      allow read, write: if isAdmin();
    }
  }
}
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Role-based helper from user profile doc
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isCreator() {
      return isAuthenticated() && (
        isAdmin() ||
        request.auth.token.role == 'creator' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'creator'
      );
    }

    // Series collection: published stories are public; authors can see their own workflow states.
    match /series/{seriesId} {
      allow read: if resource.data.approvalStatus == 'published' || isAdmin() ||
        (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.approvalStatus in ['draft', 'pending', 'published'] &&
        request.resource.data.createdAt == request.time &&
        (!request.resource.data.keys().hasAny(['featured']) || request.resource.data.featured == false) &&
        (!request.resource.data.keys().hasAny(['isFeatured']) || request.resource.data.isFeatured == false) &&
        (!request.resource.data.keys().hasAny(['isTrending']) || request.resource.data.isTrending == false) &&
        (!request.resource.data.keys().hasAny(['isEditorPick']) || request.resource.data.isEditorPick == false) &&
        (!request.resource.data.keys().hasAny(['views']) || request.resource.data.views == 0) &&
        (!request.resource.data.keys().hasAny(['followersCount']) || request.resource.data.followersCount == 0) &&
        (!request.resource.data.keys().hasAny(['rating']) || request.resource.data.rating == 0) &&
        (!request.resource.data.keys().hasAny(['ratingCount']) || request.resource.data.ratingCount == 0)
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.authorId == request.auth.uid &&
        request.resource.data.authorId == request.auth.uid &&
        resource.data.approvalStatus != 'rejected' &&
        request.resource.data.approvalStatus in ['draft', 'pending', 'published'] &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'featured', 'isFeatured', 'isTrending', 'isEditorPick',
          'views', 'followersCount', 'rating', 'ratingCount', 'createdAt'
        ])
      ) || (
        resource.data.approvalStatus == 'published' &&
        request.resource.data.approvalStatus == 'published' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
        request.resource.data.get('views', 0) == resource.data.get('views', 0) + 1
      ) || (
        isAuthenticated() &&
        resource.data.approvalStatus == 'published' &&
        request.resource.data.approvalStatus == 'published' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']) &&
        (
          request.resource.data.get('followersCount', 0) == resource.data.get('followersCount', 0) + 1 ||
          request.resource.data.get('followersCount', 0) == resource.data.get('followersCount', 0) - 1
        )
      );
      allow delete: if isAdmin();
    }

    // Chapters follow the visibility and ownership of their parent story.
    match /chapters/{chapterId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && get(/databases/$(database)/documents/series/$(resource.data.seriesId)).data.authorId == request.auth.uid) ||
        (resource.data.approvalStatus == 'published' && resource.data.isDraft != true &&
          get(/databases/$(database)/documents/series/$(resource.data.seriesId)).data.approvalStatus == 'published');
      allow create: if isAdmin() || (
        isAuthenticated() &&
        get(/databases/$(database)/documents/series/$(request.resource.data.seriesId)).data.authorId == request.auth.uid &&
        get(/databases/$(database)/documents/series/$(request.resource.data.seriesId)).data.approvalStatus != 'rejected' &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.approvalStatus in ['draft', 'published'] &&
        request.resource.data.isDraft == (request.resource.data.approvalStatus == 'draft')
      );
      allow update: if isAdmin() || (
        isAuthenticated() &&
        get(/databases/$(database)/documents/series/$(resource.data.seriesId)).data.authorId == request.auth.uid &&
        request.resource.data.seriesId == resource.data.seriesId &&
        get(/databases/$(database)/documents/series/$(resource.data.seriesId)).data.approvalStatus != 'rejected' &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.approvalStatus in ['draft', 'published'] &&
        request.resource.data.isDraft == (request.resource.data.approvalStatus == 'draft')
      );
      allow delete: if isAdmin();
    }

    // Users collection.
    // SECURITY: a normal user can NEVER change their own role / ban status.
    // Admin is set manually in Firebase Console (users/{uid}.role = "admin").
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.get('isBanned', false) == resource.data.get('isBanned', false)
      );
      allow delete: if isAdmin();
    }

    // Follows collection
    match /follows/{followId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User Library & History
    match /library/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || resource.data.userId == request.auth.uid);
    }

    match /readingHistory/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Collections (user curated reading lists)
    match /collections/{collectionId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // Community forum posts
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // Creator submissions queue
    match /submissions/{submissionId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.creatorId == request.auth.uid);
      allow create: if isCreator();
      allow update, delete: if isAdmin();
    }

    // Site Settings (admin only write)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
